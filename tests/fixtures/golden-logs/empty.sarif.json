{
    "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
    "version": "2.1.0",
    "runs": [
        {
            "tool": {
                "driver": {
                    "name": "phpcpd-next",
                    "informationUri": "https://github.com/phpcpd-next/phpcpd",
                    "version": "2.0.0",
                    "rules": [
                        {
                            "id": "duplicate-code",
                            "name": "DuplicateCode",
                            "shortDescription": {
                                "text": "Exact duplicated code (Type-1/2)."
                            }
                        },
                        {
                            "id": "inconsistent-clone",
                            "name": "InconsistentClone",
                            "shortDescription": {
                                "text": "Gapped (Type-3) clone \u2014 copies diverge; bug risk."
                            }
                        },
                        {
                            "id": "reordered-clone",
                            "name": "ReorderedClone",
                            "shortDescription": {
                                "text": "Reordered (Type-3) clone \u2014 same material, different sequence."
                            }
                        }
                    ]
                }
            },
            "results": []
        }
    ]
}
